{
  "name": "youtube-transcript-viewer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others --names api,web --prefix-colors blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node server/main.ts",
    "start:web": "ng serve",
    "build": "ng build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test \"server/**/*.test.ts\"",
    "test:web": "ng test --watch=false",
    "typecheck": "tsc -p server",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@shared/types": "file:./types",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
